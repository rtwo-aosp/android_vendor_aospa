license {
    name: "vendor_aospa_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

// Kernel UAPI headers for the Motorola sm8550 kernel (stands in for the
// qti_kernel_headers module normally provided by the Qualcomm kernel tree)
cc_library_headers {
    name: "qti_kernel_headers",
    vendor_available: true,
    recovery_available: true,
    host_supported: false,
    export_include_dirs: [
        "../../kernel/motorola/sm8550/include/uapi",
        "../../kernel/motorola/sm8550/arch/arm64/include/uapi",
    ],
    visibility: ["//visibility:public"],
}

// Display UAPI headers (sde_drm.h, msm_drm_pp.h) from the Motorola
// display-drivers tree; stands in for the namespaced module in sm8550-modules
cc_library_headers {
    name: "qti_display_kernel_headers",
    vendor: true,
    recovery_available: true,
    export_include_dirs: [
        "../../kernel/motorola/sm8550-modules/qcom/opensource/display-drivers/include/uapi",
    ],
    visibility: ["//visibility:public"],
}

// Stand-in for the LineageOS generated_kernel_headers module, which the
// Motorola fingerprint HAL uses (raw UAPI headers from the Motorola kernel)
cc_library_headers {
    name: "generated_kernel_headers",
    vendor: true,
    export_include_dirs: [
        "../../kernel/motorola/sm8550/include/uapi",
        "../../kernel/motorola/sm8550/arch/arm64/include/uapi",
    ],
    visibility: ["//visibility:public"],
}
